# Kopieer dit bestand naar .env en vul je eigen waarden in. .env staat in .gitignore.
# Zonder AI-sleutel werken CSV, CODA, regels en tekst-PDF-facturen gewoon.
# Na een wijziging: app herstarten.

# --- Welke AI gebruik je? ---------------------------------------------------------------
# Aanbieder voor beide taken: gemini | anthropic | openai | azure_openai | mistral | openai_compatibel
LLM_PROVIDER=gemini
# Per taak een andere aanbieder of een ander model (optioneel; anders het standaardmodel uit de catalogus).
# Dit kan je ook gewoon in de app kiezen (pagina AI-modellen); die keuze gaat voor op .env.
# LLM_PROVIDER_DOCUMENTEN=gemini
# LLM_PROVIDER_CATEGORISATIE=mistral
# LLM_MODEL_DOCUMENTEN=gemini-3.8-flash
# LLM_MODEL_CATEGORISATIE=mistral-small-latest

# Stuur bij elke aanbieder de tekst uit de PDF i.p.v. het bestand zelf (goedkoper, geen gescande PDF's).
# LLM_PDF_ALS_TEKST=1

# --- Sleutels (enkel die van de aanbieders die je gebruikt) ------------------------------------
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude: https://platform.claude.com
# ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Azure OpenAI / Azure AI Foundry: endpoint van je resource; als model geef je de deploymentnaam op.
# AZURE_OPENAI_ENDPOINT=https://mijn-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=

# Mistral AI (EU): https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# OpenAI-compatibel endpoint: Ollama (lokaal), LM Studio, OpenRouter, vLLM, ...
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=

# --- Mappen (optioneel, relatief t.o.v. deze map of absoluut) ------------------------------------
# BOEKHOUDING_DATA_DIR=data
# BOEKHOUDING_INBOX_DIR=inbox
